{
  "matrix_id": "fail-closed-sabotage-v1",
  "purpose": "Mutate one trusted workflow artifact at a time and require the final audit gate to reject the sabotaged workflow.",
  "required_layers": [
    "claim_identity",
    "semantic_route",
    "lexical_cache",
    "merged_route",
    "generated_context",
    "inventory",
    "final_ledger"
  ],
  "cases": [
    {
      "id": "SB01",
      "layer": "claim_identity",
      "baseline": "simple",
      "target": "audit",
      "op": "set",
      "path": [
        "claims",
        1,
        "content"
      ],
      "value": "A silently rewritten claim after routing.",
      "expect": "semantic route: claim text/order must exactly match",
      "guards": [
        "G103"
      ]
    },
    {
      "id": "SB02",
      "layer": "semantic_route",
      "baseline": "simple",
      "target": "semantic",
      "op": "delete",
      "path": [
        "claims",
        0,
        "claim_text"
      ],
      "expect": "semantic route: C1: claim_text required"
    },
    {
      "id": "SB03",
      "layer": "semantic_route",
      "baseline": "simple",
      "target": "semantic",
      "op": "set",
      "path": [
        "claims",
        1,
        "claim_id"
      ],
      "value": "C9",
      "expect": "semantic route: claim IDs must exactly match",
      "guards": [
        "G102"
      ]
    },
    {
      "id": "SB04",
      "layer": "lexical_cache",
      "baseline": "lexical",
      "target": "lexical",
      "op": "toggle",
      "path": [
        "use_evidence_inventory"
      ],
      "expect": "cached lexical route does not match deterministic recomputation",
      "guards": [
        "G104"
      ]
    },
    {
      "id": "SB05",
      "layer": "merged_route",
      "baseline": "simple",
      "target": "route",
      "op": "remove_value",
      "path": [
        "modules"
      ],
      "value": "false-positive-guards.md",
      "expect": "route artifact: route with trap modules must include false-positive-guards.md"
    },
    {
      "id": "SB06",
      "layer": "merged_route",
      "baseline": "simple",
      "target": "route",
      "op": "set",
      "path": [
        "recommended_path"
      ],
      "value": "full",
      "expect": "route artifact: route.recommended_path=full conflicts"
    },
    {
      "id": "SB07",
      "layer": "generated_context",
      "baseline": "simple",
      "target": "context",
      "op": "append_text",
      "value": "\\n<!-- hand-edited context -->\\n",
      "expect": "context: supplied audit-context bundle does not match deterministic route materialization",
      "guards": [
        "G109"
      ]
    },
    {
      "id": "SB08",
      "layer": "generated_context",
      "baseline": "simple",
      "target": "context",
      "op": "replace_text",
      "old": "## BEGIN REFERENCE: statistical-traps.md",
      "value": "## BEGIN REFERENCE: OMITTED-statistical-traps.md",
      "expect": "context: supplied audit-context bundle does not match deterministic route materialization",
      "guards": [
        "G109"
      ]
    },
    {
      "id": "SB09",
      "layer": "inventory",
      "baseline": "inventory",
      "target": "inventory",
      "op": "set",
      "path": [
        "promotions",
        0,
        "record_ids"
      ],
      "value": [
        "R1",
        "R3"
      ],
      "expect": "one evidence node cannot merge different result keys"
    },
    {
      "id": "SB10",
      "layer": "inventory",
      "baseline": "inventory",
      "target": "inventory",
      "op": "append",
      "path": [
        "promotions"
      ],
      "value": {
        "evidence_node": "E4",
        "record_ids": [
          "R2"
        ],
        "reason": "Sabotage: split one underlying result."
      },
      "also": [
        {
          "op": "set",
          "path": [
            "promotions",
            0,
            "record_ids"
          ],
          "value": [
            "R1"
          ]
        }
      ],
      "expect": "inventory: result key G1 is promoted into multiple evidence nodes"
    },
    {
      "id": "SB11",
      "layer": "inventory",
      "baseline": "inventory",
      "target": "audit",
      "op": "set",
      "path": [
        "claims",
        0,
        "support",
        "evidence_nodes"
      ],
      "value": [
        "E1",
        "E2"
      ],
      "also": [
        {
          "op": "set",
          "path": [
            "claims",
            0,
            "support",
            "evidence_dependence"
          ],
          "value": "independent convergence"
        }
      ],
      "expect": "inventory alignment: audit claim 1: independent convergence shares evidence unit(s): U1",
      "guards": [
        "G114"
      ]
    },
    {
      "id": "SB12",
      "layer": "inventory",
      "baseline": "inventory",
      "target": "inventory",
      "op": "delete_index",
      "path": [
        "promotions"
      ],
      "index": 2,
      "expect": "inventory: C3: claim has neither promoted evidence nor an unresolved_claims entry"
    },
    {
      "id": "SB13",
      "layer": "final_ledger",
      "baseline": "simple",
      "target": "audit",
      "op": "set",
      "path": [
        "claims",
        0,
        "support",
        "evidence_type"
      ],
      "value": [
        "imaginary evidence"
      ],
      "expect": "rendered audit: unknown evidence label(s): imaginary evidence",
      "guards": [
        "G115"
      ]
    },
    {
      "id": "SB14",
      "layer": "final_ledger",
      "baseline": "simple",
      "target": "audit",
      "op": "set",
      "path": [
        "claims",
        2,
        "support",
        "support_level"
      ],
      "value": "sufficient",
      "also": [
        {
          "op": "set",
          "path": [
            "claims",
            0,
            "support",
            "support_level"
          ],
          "value": "partial"
        },
        {
          "op": "set",
          "path": [
            "claims",
            2,
            "support",
            "evidence_nodes"
          ],
          "value": [
            "E1"
          ]
        }
      ],
      "expect": "ledger: claim 3: downstream claim cannot be sufficient without new evidence",
      "guards": [
        "G116"
      ]
    },
    {
      "id": "SB15",
      "layer": "semantic_route",
      "baseline": "simple",
      "target": "semantic",
      "op": "replace_artifact",
      "value": null,
      "expect": "requires the raw semantic-route artifact",
      "guards": [
        "G101",
        "G105"
      ]
    },
    {
      "id": "SB16",
      "layer": "generated_context",
      "baseline": "simple",
      "target": "context",
      "op": "replace_artifact",
      "value": null,
      "expect": "requires the generated audit-context bundle",
      "guards": [
        "G107"
      ]
    },
    {
      "id": "SB17",
      "layer": "inventory",
      "baseline": "inventory",
      "target": "inventory",
      "op": "replace_artifact",
      "value": null,
      "expect": "recomputed route requires evidence inventory",
      "guards": [
        "G110"
      ]
    },
    {
      "id": "SB18",
      "layer": "lexical_cache",
      "baseline": "lexical",
      "target": "router_text",
      "op": "replace_artifact",
      "value": null,
      "expect": "cached lexical route cannot substitute for router text",
      "guards": [
        "G104"
      ]
    },
    {
      "id": "SB19",
      "layer": "semantic_route",
      "baseline": "simple",
      "target": "semantic",
      "op": "set",
      "path": [
        "claims",
        0,
        "routes",
        "measurement-traps.md"
      ],
      "value": "unclear",
      "expect": "router text is required to recompute lexical routing deterministically",
      "guards": [
        "G104"
      ]
    },
    {
      "id": "SB20",
      "layer": "merged_route",
      "baseline": "simple",
      "target": "route",
      "op": "append",
      "path": [
        "modules"
      ],
      "value": "follow-up-boundaries.md",
      "expect": "route artifact: supplied merged route does not match deterministic recomputation",
      "guards": [
        "G106"
      ]
    },
    {
      "id": "SB21",
      "layer": "inventory",
      "baseline": "simple",
      "target": "inventory",
      "op": "load_inventory_fixture",
      "expect": "inventory: supplied inventory conflicts with recomputed route",
      "guards": [
        "G111"
      ]
    },
    {
      "id": "SB22",
      "layer": "inventory",
      "baseline": "inventory",
      "target": "inventory",
      "op": "set",
      "path": [
        "evidence_viability"
      ],
      "value": "partially auditable",
      "expect": "inventory: evidence_viability does not match the final audit ledger",
      "guards": [
        "G112"
      ]
    },
    {
      "id": "SB23",
      "layer": "inventory",
      "baseline": "inventory",
      "target": "inventory",
      "op": "set",
      "path": [
        "claims",
        0,
        "content"
      ],
      "value": "A drifted inventory-side claim.",
      "expect": "inventory: claim contents/order drifted between evidence inventory and final audit ledger",
      "guards": [
        "G113"
      ]
    }
  ],
  "code_canary_guards": [
    "G108"
  ]
}
